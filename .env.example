# Gmail OAuth credentials (from Google Cloud Console)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ADDRESS=

# Anthropic API
ANTHROPIC_API_KEY=

# Tenant configuration
TENANT_ID=dev

# Optional overrides
POLL_INTERVAL_MINUTES=5
GMAIL_TOKEN_FILE=gmail_token.json
DB_PATH=emails.db

# After first OAuth run: copy the gmail_token_b64 value from POST /api/oauth/complete response
# Paste it here so the token survives Railway redeploys
GMAIL_TOKEN_JSON=
